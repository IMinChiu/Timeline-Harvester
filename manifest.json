{
    "manifest_version": 3,
    "name": "FB-Timeline-Harvester",
    "version": "1.0",
    "description": "A high-stability sequential harvester for Facebook Timeline data collection.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "https://api.openai.com/*"
    ],
    "action": {},
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
        "matches": ["https://www.facebook.com/*"],
        "js": ["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
        "resources": ["injected.js"],
        "matches": ["https://www.facebook.com/*"]
        }
    ]
}